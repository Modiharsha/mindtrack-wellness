# Server Configuration
PORT=5000
NODE_ENV=development

# Database URL
# For SQLite (default, zero-setup):
DATABASE_URL="file:./dev.db"

# For PostgreSQL:
# DATABASE_URL="postgresql://username:password@localhost:5432/mindtrack?schema=public"

# Auth Secrets
JWT_SECRET="mindtrack_super_secure_jwt_secret_change_in_production"
JWT_EXPIRES_IN="7d"
